# Copy this file to .env.local and fill in real values.
# Never commit .env.local: the repo is public.

# Password for the app's lock screen (Phase 1)
APP_PASSWORD=

# Claude API key from console.anthropic.com (server only)
ANTHROPIC_API_KEY=

# Supabase: Project Settings > API Keys. Use the secret key (sb_secret_...), server only.
SUPABASE_URL=https://etwrxyugwgwcydofoqrd.supabase.co
SUPABASE_SECRET_KEY=

# Only if you use Voyage AI for embeddings instead of Supabase's built-in model
VOYAGE_API_KEY=

# Push notifications for calendar reminders. Make the pair with
# `npx web-push generate-vapid-keys`; CRON_SECRET is any long random string,
# also stored in Supabase Vault for the pg_cron job that calls /api/reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

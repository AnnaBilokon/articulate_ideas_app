# Copy this file to .env.local and fill in real values.
# Never commit .env.local: the repo is public.

# Password for the app's lock screen (Phase 1)
APP_PASSWORD=

# Claude API key from console.anthropic.com (server only)
ANTHROPIC_API_KEY=

# Supabase project settings > API (server only; never expose the service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only if you use Voyage AI for embeddings instead of Supabase's built-in model
VOYAGE_API_KEY=
